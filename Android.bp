package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "MikuSettings-core",
    platform_apis: true,
    manifest: "AndroidManifest-res.xml",
    use_resource_processor: true,
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    static_libs: [
        "Settings-core",
    ],
    resource_dirs: [],
}

android_app {
    name: "MikuSettings",
    defaults: [
        "platform_app_defaults",
        "SpaPrivilegedLib-defaults",
        "Settings_optimized_defaults",
    ],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    required: [
        "privapp_whitelist_com.android.settings",
        "settings-platform-compat-config",
    ],
    static_libs: [
        "MikuSettings-core",
    ],
    use_resource_processor: true,
    uses_libs: ["org.apache.http.legacy"],
    resource_dirs: [],
    flags_packages: [
        "android.app.flags-aconfig",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
        included_proguard_flags_files: [
            "//packages/apps/Settings:Settings_proguard_flags",
        ],
    },
    overrides: [
        "Settings",
    ],
}
